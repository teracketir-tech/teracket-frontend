<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <link href="Css/MasterPage.css" rel="stylesheet" type="text/css" />
    <link href="Css/superfish.css" rel="stylesheet" type="text/css" />
    <link href="Css/tbls.css" rel="stylesheet" type="text/css" />
    <script src="js/jquery-1.11.3.min.js" type="text/javascript"></script>
    <script src="js/jquery.li-scroller.1.0.js" type="text/javascript"></script>
    <script src="js/jquery-1.7.1.min.js" type="text/javascript"></script>
    <link href="jscss_flick_ui/jquery-ui-1.8.16.custom.css" rel="stylesheet" type="text/css" />
    <script src="jscss_flick_ui/jquery-ui-1.8.16.custom.min.js" type="text/javascript"></script>
    <script src="js/MasterPage.js" type="text/javascript"></script>
    <script src="js/public.js" type="text/javascript"></script>
    <link href="Css/MessageBox.css" rel="stylesheet" type="text/css" />
    <link href="Css/animate.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body id="main">

    <form id="form1" runat="server" autocomplete="off">
        <div class="Headerdiv">
            <table width="100%" align="center" dir="rtl">
                <tr>
                    <td valign="top" align="right">
                        <table align="center" dir="rtl" width="980">
                            <tr style="height: 43px">
                                <td width="10"></td>
                                <td width="50" align="right" class="Menu" id="tdImgAbnama">
                                    <img id="avatar_image" alt="" src="/images/avatar_image.jpg" style="cursor: pointer; width: 40px; height: 40px;" runat="server" />
                                </td>
                                <td>
                                    <asp:Label ID="lblName" runat="server" ForeColor="#ffffff" Font-Size="14"></asp:Label>
                                </td>
                                <td align="center" class="Menu"></td>
                                <td width="200" align="center" class="Menu"></td>
                                <td width="150" align="center" class="Menu"></td>
                                <td align="center" class="Menu" width="50" valign="middle">
                                    <asp:LinkButton ID="nkbtnSignOut" runat="server" OnClick="nkbtnSignOut_Click" CssClass="Normal"><img alt="خروج" src="/images/logout.png" style="width: 25px;" /></asp:LinkButton>

                                    <%--<a href="login.aspx" title="خروج">
                                        <img alt="خروج" src="/images/logout.png" style="width: 25px;" />
                                    </a>--%>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
        <table align="center" cellpadding="2" width="980" dir="rtl" style="margin-top: 50px;">
            <tr>
                <td id="RightMenu" valign="top" align="center" style="width: 180px;">
                    <div class="headerbar" style="height: 26px; font-size: 18px; color: #333; border-top-color: #7266ba;">
                        <asp:Label ID="lblDate" runat="server"></asp:Label>
                    </div>
                    <div id="MainMenu" class="headerbar" style="padding: 0;">
                        <asp:Literal ID="lblMenu" runat="server" Text=""></asp:Literal>
                    </div>
                    <div class="headerbar" style="border-top: 3px solid #fff;" id="divResaulContractAll" runat="server">
                        <ul style="margin-bottom: 0px;" class="Report">
                            <li><a id="link2EndContract"><span style="float: right;">تعداد پرسنلی که قراردادشان به اتمام رسیده :</span><span id="ResultRet2EndContract">0</span></a></li>
                            <li><a id="link2NoneWorkgroup"><span style="float: right;">تعداد پرسنلی که گروه کاری ندارند :</span><span id="ResultRet2NoneWorkGroup">0</span></a></li>
                            <li><a id="link2NewPeikRegister"><span style="float: right;">موزعین جدید که کد پرسنلی و قرارداد ندارند:</span><span id="ResultRet2NewPeik">0</span></a></li>
                        </ul>
                    </div>
                </td>
                <td id="Main" align="center" valign="top">
                    <div class="headerbar" align="right" style="height: 26px; border-top: 3px solid #7266ba;">
                   
                        <asp:Label ID="lbltitle" runat="server" Text=""></asp:Label>
                    </div>
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </td>
            </tr>
        </table>
        <div id="divAlert" align="center" dir="rtl">
        </div>
        <div id="BackGround">
        </div>
        <div id="CheckOut">
        </div>
        <div id="Note" align="center" dir="rtl">
        </div>
        <div id="Loading" style="display: none;" dir="rtl">
            <table class='Note' align='center' cellpadding='2' dir='rtl'>
                <tr>
                    <td width='50'>
                        <img alt='خطا' class='NoteImg' src='Images/bigloading.gif' />
                    </td>
                    <td align='center'>سیستم در حال بار گزاری اطلاعات می باشد .
                    <br />
                        لطفا کمی صبور باشید .
                    </td>
                </tr>
            </table>
        </div>
        
        <div id="divsrch" class="headerbar" align="center" style="">
        </div>
        <div id="divOrder" class="headerbar" align="center" style="">
        </div>
        
        
    </form>



    <div id="descriptionbox">
        <div id="descriptiondiv" align="right" style="direction: rtl;"></div>
    </div>
    <div class="ImgUpload" align="center" dir="rtl" id="divImgUpload">
        <div>
            <table>
                <tr>
                    <td align="center" colspan="2">
                        <h4 style="font-family: Tahoma;">انتخاب تصویر پنل کاربری خود</h4>
                    </td>
                </tr>
                <tr>
                    <td align="right">
                        <div class="fileUpload btn btn-primary">
                            <span>Upload</span>
                            <input id="uploaderImg" class="upload" type="file" onchange="CheckImagPaneleFormatSize('uploaderImg')" />
                        </div>
                    </td>
                    <td align="right">
                        <input id="uploadFile" placeholder="Choose File" disabled="disabled" />
                    </td>
                </tr>
            </table>
        </div>
        <div>
            <table>
                <tr>
                    <td colspan="2" id="tdalarm"></td>
                </tr>
            </table>
        </div>
    </div>
</body>
</html>

